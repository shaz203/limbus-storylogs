{
  "id": "prologue",
  "title": "Selva Oscura",
  "chapterLabel": "Prologue",
  "year": "984 - 1",
  "scenes": [
    {
      "episode": 1,
      "location": "A Dark Forest",
      "speaker": "Wolf",
      "text": "Do you see now? You can't run from us.",
      "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
      "left": "",
      "center": "",
      "right": "",
      "cg": "",
      "type": "dialogue"
    },
      {
    "episode": 1,
    "location": "A Dark Forest",
    "speaker": "Dante",
    "text": "<You dare… interrupt me just as I was engraving the ■■■■■■… You must be out of your…>",
    "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
    "left": "",
    "center": "",
    "right": "",
    "cg": "",
    "type": "dialogue"
  },
  {
    "episode": 1,
    "location": "A Dark Forest",
    "speaker": "Lion",
    "text": "Ah~ If we’re being technical, what our master has planned apparently isn’t one of the City’s taboos.",
    "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
    "left": "",
    "center": "",
    "right": "",
    "cg": "",
    "type": "dialogue"
  },
  {
    "episode": 1,
    "location": "A Dark Forest",
    "speaker": "Lion",
    "text": "It’s just the kind of thing that… no one has ever dared to consider, you catch my drift?",
    "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
    "left": "",
    "center": "",
    "right": "",
    "cg": "",
    "type": "dialogue"
  },
  {
    "episode": 1,
    "location": "A Dark Forest",
    "speaker": "Lion",
    "text": "Huh, would you look at that…",
    "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
    "left": "",
    "center": "",
    "right": "",
    "cg": "",
    "type": "dialogue"
  },
{
  "episode": 1,
  "location": "A Dark Forest",
  "speaker": "Panther",
  "text": "You managed to get a different head in so fast. Do people like you always come prepared?",
  "background": "/limbus-storylogs/assets/covers/backgrounds/Dark_Forest.png",
  "left": "",
  "center": "",
  "right": "/limbus-storylogs/Sprite/Prologue/Panther/Panther.png",
  "spriteAdjust": {
    "right": {
      "scale": 2,
      "x": -40,
      "y": -50
    }
  },
  "cg": "",
  "type": "dialogue"
},


  {
      "speaker": "Dante",
      "text": "<Kngh… Just wait ‘til I get the ■■■■■■… You’ll be no match for my…>",
      "background": "/limbus-storylogs/assets/covers/backgrounds/Dark_Forest.png",
      "left": "/limbus-storylogs/Sprite/Sinners/Dante/Dante.webp",
      "right": "/limbus-storylogs/Sprite/Prologue/Panther/Panther.png",
  "spriteAdjust": {
    "right": {
      "scale": 2,
      "x": -40,
      "y": -50
    },
  "left": {
      "scale": 2,
      "x": 200,
      "y": -120}
  },
      "type": "dialogue"
    },


    {
      "speaker": "Lion",
      "text": "Haha, I guess that new noggin doesn’t come with a mouth, huh?",
      "background": "/limbus-storylogs/assets/covers/backgrounds/Dark_Forest.png",
      "left": "/limbus-storylogs/Sprite/Sinners/Dante/Dante.webp",
      "right": "/limbus-storylogs/Sprite/Prologue/Lion/Lion.png",
      "spriteAdjust": {
    "right": {
      "scale": 2,
      "x": -40,
      "y": -50
    },
  "left": {
      "scale": 2,
      "x": 200,
      "y": -120}
  },
      "type": "dialogue"
    },
    {
      "speaker": "Wolf",
      "text": "Yep, ticking is all I can hear. You think they’re screaming on the inside?",
      "background": "/limbus-storylogs/assets/covers/backgrounds/Dark_Forest.png",
      "left": "/limbus-storylogs/Sprite/Sinners/Dante/Dante.webp",
      "right": "/limbus-storylogs/Sprite/Prologue/Wolf/Wolf.png",
      "spriteAdjust": {
    "right": {
      "scale": 2,
      "x": -40,
      "y": -50
    },
  "left": {
      "scale": 2,
      "x": 200,
      "y": -120}},
      "type": "dialogue"
    },
    {
      "speaker": "Dante",
      "text": "<Ghaagh…!>",
      "background": "/limbus-storylogs/assets/covers/backgrounds/Dark_Forest.png",
      "center": "/limbus-storylogs/Sprite/Sinners/Dante/Dante.webp",
            "spriteAdjust": {
    "center": {
      "scale": 2,
      "x": -40,
      "y": -120
    }},
      "type": "dialogue"
    },
    {
      "speaker": "Wolf",
      "text": "Hmm. It’s ticking faster, so I guess they can still feel pain.",
      "background": "/limbus-storylogs/assets/covers/backgrounds/Dark_Forest.png",
      "left": "/limbus-storylogs/Sprite/Sinners/Dante/Dante.webp",
      "right": "/limbus-storylogs/Sprite/Prologue/Wolf/Wolf.png",
      "spriteAdjust": {
    "right": {
      "scale": 2,
      "x": -40,
      "y": -50
    },
  "left": {
      "scale": 2,
      "x": 200,
      "y": -120}},
      "type": "dialogue"
    },
    {
      "speaker": "Narration",
      "text": "Dammit… Why… am I…!",
      "background": "/limbus-storylogs/assets/covers/backgrounds/Dark_Forest.png",
      "left": "/limbus-storylogs/Sprite/Sinners/Dante/Dante.webp",
      "right": "/limbus-storylogs/Sprite/Prologue/Wolf/Wolf.png",
      "spriteAdjust": {
    "right": {
      "scale": 2,
      "x": -40,
      "y": -50
    },
  "left": {
      "scale": 2,
      "x": 200,
      "y": -120}},
      "type": "narration"
    },
    {
      "speaker": "Narration",
      "text": "…Why am I being attacked?",
      "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
      "type": "narration"
    },
    {
      "speaker": "Narration",
      "text": "Not good… Memories are dissolving already… The ■■■ was done too quick…",
      "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
      "type": "narration"
    },
    {
      "speaker": "Wolf",
      "text": "What, they’ve gone quiet already. Let’s get this over with.",
      "background": "/limbus-storylogs/assets/covers/backgrounds/Dark_Forest.png",
      "left": "/limbus-storylogs/Sprite/Sinners/Dante/Dante.webp",
      "right": "/limbus-storylogs/Sprite/Prologue/Wolf/Wolf.png",
      "center": "/limbus-storylogs/Sprite/Prologue/Lion/Lion.png",
      "spriteAdjust": {
    "right": {
      "scale": 2,
      "x": -40,
      "y": -50
    },
  "left": {
      "scale": 2,
      "x": 200,
      "y": -120},
    "center": {
      "scale": 2,
      "x": 200,
      "y": -50
    }},
      "type": "dialogue"
    },
    {
      "speaker": "Lion",
      "text": "Wolf, this is a place no one visits and somewhere none can see. What’s the hurry?",
      "background": "/limbus-storylogs/assets/covers/backgrounds/Dark_Forest.png",
      "left": "/limbus-storylogs/Sprite/Sinners/Dante/Dante.webp",
      "right": "/limbus-storylogs/Sprite/Prologue/Wolf/Wolf.png",
      "center": "/limbus-storylogs/Sprite/Prologue/Lion/Lion.png",
      "spriteAdjust": {
    "right": {
      "scale": 2,
      "x": -40,
      "y": -50
    },
  "left": {
      "scale": 2,
      "x": 200,
      "y": -120},
    "center": {
      "scale": 2,
      "x": 200,
      "y": -50
    }},
      "type": "dialogue"
    },
    {
      "speaker": "Wolf",
      "text": "We must follow her teachings. We can’t drag on any longer.",
      "background": "/limbus-storylogs/assets/covers/backgrounds/Dark_Forest.png",
      "left": "/limbus-storylogs/Sprite/Sinners/Dante/Dante.webp",
      "right": "/limbus-storylogs/Sprite/Prologue/Wolf/Wolf.png",
      "center": "/limbus-storylogs/Sprite/Prologue/Lion/Lion.png",
      "spriteAdjust": {
    "right": {
      "scale": 2,
      "x": -40,
      "y": -50
    },
  "left": {
      "scale": 2,
      "x": 200,
      "y": -120},
    "center": {
      "scale": 2,
      "x": 200,
      "y": -50
    }},
      "type": "dialogue"
    },
    {
      "speaker": "Lion",
      "text": "Yeah, but… Haa, this is the moment of a lifetime. We’re not gonna get a second chance to kill someone of this caliber…",
      "background": "/limbus-storylogs/assets/covers/backgrounds/Dark_Forest.png",
      "left": "/limbus-storylogs/Sprite/Sinners/Dante/Dante.webp",
      "right": "/limbus-storylogs/Sprite/Prologue/Wolf/Wolf.png",
      "center": "/limbus-storylogs/Sprite/Prologue/Lion/Lion.png",
      "spriteAdjust": {
    "right": {
      "scale": 2,
      "x": -40,
      "y": -50
    },
  "left": {
      "scale": 2,
      "x": 200,
      "y": -120},
    "center": {
      "scale": 2,
      "x": 200,
      "y": -50
    }},
      "type": "dialogue"
    },
    {
      "speaker": "Panther",
      "text": "Lion, you have a tendency to grow too emotional during your jobs. I hope you show some discretion.",
      "background": "/limbus-storylogs/assets/covers/backgrounds/Dark_Forest.png",
      "left": "/limbus-storylogs/Sprite/Sinners/Dante/Dante.webp",
      "right": "/limbus-storylogs/Sprite/Prologue/Panther/Panther.png",
      "center": "/limbus-storylogs/Sprite/Prologue/Lion/Lion.png",
      "spriteAdjust": {
    "right": {
      "scale": 2,
      "x": -40,
      "y": -50
    },
  "left": {
      "scale": 2,
      "x": 200,
      "y": -120},
    "center": {
      "scale": 2,
      "x": 200,
      "y": -50
    }},
      "type": "dialogue"
    },
    {
      "speaker": "Lion",
      "text": "Pshaw…",
      "background": "/limbus-storylogs/assets/covers/backgrounds/Dark_Forest.png",
      "left": "/limbus-storylogs/Sprite/Sinners/Dante/Dante.webp",
      "right": "/limbus-storylogs/Sprite/Prologue/Panther/Panther.png",
      "center": "/limbus-storylogs/Sprite/Prologue/Lion/Lion.png",
      "spriteAdjust": {
    "right": {
      "scale": 2,
      "x": -40,
      "y": -50
    },
  "left": {
      "scale": 2,
      "x": 200,
      "y": -120},
    "center": {
      "scale": 2,
      "x": 200,
      "y": -50
    }},
      "type": "dialogue"
    },
    {
      "speaker": "Panther",
      "text": "It’s a shame—I wanted to have a look at your face. I reckon you won’t tell us where your star is, right?",
      "background": "/limbus-storylogs/assets/covers/backgrounds/Dark_Forest.png",
      "left": "/limbus-storylogs/Sprite/Sinners/Dante/Dante.webp",
      "right": "/limbus-storylogs/Sprite/Prologue/Panther/Panther.png",
      "center": "/limbus-storylogs/Sprite/Prologue/Lion/Lion.png",
      "spriteAdjust": {
    "right": {
      "scale": 2,
      "x": -40,
      "y": -50
    },
  "left": {
      "scale": 2,
      "x": 200,
      "y": -120},
    "center": {
      "scale": 2,
      "x": 200,
      "y": -50
    }},
      "type": "dialogue"
    },
    {
      "speaker": "Dante",
      "text": "<Like hell I am. I’m taking ■■■’s location to the grave with…>",
      "background": "/limbus-storylogs/assets/covers/backgrounds/Dark_Forest.png",
      "left": "/limbus-storylogs/Sprite/Sinners/Dante/Dante.webp",
      "right": "/limbus-storylogs/Sprite/Prologue/Panther/Panther.png",
      "center": "/limbus-storylogs/Sprite/Prologue/Lion/Lion.png",
      "spriteAdjust": {
    "right": {
      "scale": 2,
      "x": -40,
      "y": -50
    },
  "left": {
      "scale": 2,
      "x": 200,
      "y": -120},
    "center": {
      "scale": 2,
      "x": 200,
      "y": -50
    }},
      "type": "dialogue"
    },
    {
      "speaker": "Dante",
      "text": "<……>",
      "background": "/limbus-storylogs/assets/covers/backgrounds/Dark_Forest.png",
      "left": "/limbus-storylogs/Sprite/Sinners/Dante/Dante.webp",
      "right": "/limbus-storylogs/Sprite/Prologue/Panther/Panther.png",
      "center": "/limbus-storylogs/Sprite/Prologue/Lion/Lion.png",
      "spriteAdjust": {
    "right": {
      "scale": 2,
      "x": -40,
      "y": -50
    },
  "left": {
      "scale": 2,
      "x": 200,
      "y": -120},
    "center": {
      "scale": 2,
      "x": 200,
      "y": -50
    }},
      "type": "dialogue"
    },
    {
      "speaker": "Narration",
      "text": "Dammit, where was ■■■ supposed to be again? My memories are escaping me too quickly…",
      "background": "/limbus-storylogs/assets/covers/backgrounds/Dark_Forest.png",
      "left": "/limbus-storylogs/Sprite/Sinners/Dante/Dante.webp",
      "right": "/limbus-storylogs/Sprite/Prologue/Panther/Panther.png",
      "center": "/limbus-storylogs/Sprite/Prologue/Lion/Lion.png",
      "spriteAdjust": {
    "right": {
      "scale": 2,
      "x": -40,
      "y": -50
    },
  "left": {
      "scale": 2,
      "x": 200,
      "y": -120},
    "center": {
      "scale": 2,
      "x": 200,
      "y": -50
    }},
      "type": "narration"
    },
    {
      "speaker": "Panther",
      "text": "…Right. No mouth.",
      "background": "/limbus-storylogs/assets/covers/backgrounds/Dark_Forest.png",
      "left": "/limbus-storylogs/Sprite/Sinners/Dante/Dante.webp",
      "right": "/limbus-storylogs/Sprite/Prologue/Panther/Panther.png",
      "center": "/limbus-storylogs/Sprite/Prologue/Lion/Lion.png",
      "spriteAdjust": {
    "right": {
      "scale": 2,
      "x": -40,
      "y": -50
    },
  "left": {
      "scale": 2,
      "x": 200,
      "y": -120},
    "center": {
      "scale": 2,
      "x": 200,
      "y": -50
    }},
      "type": "dialogue"
    },
    {
      "speaker": "Panther",
      "text": "Which in turn means… we won’t learn how to acquire it from this person.",
      "background": "/limbus-storylogs/assets/covers/backgrounds/Dark_Forest.png",
      "left": "/limbus-storylogs/Sprite/Sinners/Dante/Dante.webp",
      "right": "/limbus-storylogs/Sprite/Prologue/Panther/Panther.png",
      "center": "/limbus-storylogs/Sprite/Prologue/Lion/Lion.png",
      "spriteAdjust": {
    "right": {
      "scale": 2,
      "x": -40,
      "y": -50
    },
  "left": {
      "scale": 2,
      "x": 200,
      "y": -120},
    "center": {
      "scale": 2,
      "x": 200,
      "y": -50
    }},
      "type": "dialogue"
    },
    {
      "speaker": "Wolf",
      "text": "Can I end them now?",
      "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
  "backgroundLayers": [
    {
      "src": "/limbus-storylogs/Limbusart/Prologue/S0_1_1.png",
      "opacity": 0.45,
      "fit": "cover",
      "x": 0,
      "y": 0,
      "scale": 1
    }
  ],

      "type": "dialogue"
    },
    {
      "speaker": "Panther",
      "text": "Sure… Huh?",
          "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
  "backgroundLayers": [
    {
      "src": "/limbus-storylogs/Limbusart/Prologue/S0_1_1.png",
      "opacity": 0.45,
      "fit": "cover",
      "x": 0,
      "y": 0,
      "scale": 1
    }
  ],
      "type": "dialogue"
    },
    {
      "speaker": "Lion",
      "text": "Hey, what’s that noise? Don’t tell me, Panther… did you allow yourself to be tracked?",
          "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
  "backgroundLayers": [
    {
      "src": "/limbus-storylogs/Limbusart/Prologue/S0_1_1.png",
      "opacity": 0.45,
      "fit": "cover",
      "x": 0,
      "y": 0,
      "scale": 1
    }
  ],
      "type": "dialogue"
    },
    {
      "speaker": "Panther",
      "text": "No, there was no one that could’ve pursued me. Perhaps a wild animal?",
          "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
  "backgroundLayers": [
    {
      "src": "/limbus-storylogs/Limbusart/Prologue/S0_1_1.png",
      "opacity": 0.45,
      "fit": "cover",
      "x": 0,
      "y": 0,
      "scale": 1
    }
  ],
      "type": "dialogue"
    },
    {
      "speaker": "Wolf",
      "text": "This is not the sound a beast would make. It’s…",
          "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
  "backgroundLayers": [
    {
      "src": "/limbus-storylogs/Limbusart/Prologue/S0_1_1.png",
      "opacity": 0.45,
      "fit": "cover",
      "x": 0,
      "y": 0,
      "scale": 1
    }
  ],
      "type": "dialogue"
    },
    {
      "speaker": "Wolf",
      "text": "A bus…?",
          "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
  "backgroundLayers": [
    {
      "src": "/limbus-storylogs/Limbusart/Prologue/S0_1_1.png",
      "opacity": 0.45,
      "fit": "cover",
      "x": 0,
      "y": 0,
      "scale": 1
    },

    {
      "src": "/limbus-storylogs/Limbusart/Prologue/S0_1_2.png",
      "opacity": 0.45,
      "fit": "cover",
      "x": 0,
      "y": 0,
      "scale": 1
    }
  ],
      "type": "dialogue"
    },
    {
      "speaker": "Panther",
      "text": "How did it even end up here?",
                "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
  "backgroundLayers": [
    {
      "src": "/limbus-storylogs/Limbusart/Prologue/S0_1_1.png",
      "opacity": 0.45,
      "fit": "cover",
      "x": 0,
      "y": 0,
      "scale": 1
    },

    {
      "src": "/limbus-storylogs/Limbusart/Prologue/S0_1_2.png",
      "opacity": 0.45,
      "fit": "cover",
      "x": 0,
      "y": 0,
      "scale": 1
    }
  ],
      "type": "dialogue"
    },
    {
      "speaker": "Lion",
      "text": "Must’ve taken a wrong turn?",
                "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
  "backgroundLayers": [
    {
      "src": "/limbus-storylogs/Limbusart/Prologue/S0_1_1.png",
      "opacity": 0.45,
      "fit": "cover",
      "x": 0,
      "y": 0,
      "scale": 1
    },

    {
      "src": "/limbus-storylogs/Limbusart/Prologue/S0_1_2.png",
      "opacity": 0.45,
      "fit": "cover",
      "x": 0,
      "y": 0,
      "scale": 1
    }
  ],
      "type": "dialogue"
    },
    {
      "speaker": "Lion",
      "text": "Hoo, the price they’ll pay for taking the wrong road will be heavier than they expect…",
      "background": "/limbus-storylogs/Limbusart/Prologue/S0_1_5.png",
  
      "type": "dialogue"
    },
    {
      "speaker": "Lion",
      "text": "…!",
      "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
  "backgroundLayers": [
    {
      "src": "/limbus-storylogs/Limbusart/Prologue/S0_1_1.png",
      "opacity": 0.45,
      "fit": "cover",
      "x": 0,
      "y": 0,
      "scale": 1
    },

    {
      "src": "/limbus-storylogs/Limbusart/Prologue/S0_1_2.png",
      "opacity": 0.45,
      "fit": "cover",
      "x": 0,
      "y": 0,
      "scale": 1
    },

    {
      "src": "/limbus-storylogs/Limbusart/Prologue/S0_1_4.png",
      "opacity": 0.45,
      "fit": "cover",
      "x": 0,
      "y": 0,
      "scale": 1
    }
  ],
      "type": "dialogue"
    },
    {
      "speaker": "Wolf",
      "text": "…It bested Lion’s strength?",
      "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
  "backgroundLayers": [
    {
      "src": "/limbus-storylogs/Limbusart/Prologue/S0_1_1.png",
      "opacity": 0.45,
      "fit": "cover",
      "x": 0,
      "y": 0,
      "scale": 1
    },

    {
      "src": "/limbus-storylogs/Limbusart/Prologue/S0_1_2.png",
      "opacity": 0.45,
      "fit": "cover",
      "x": 0,
      "y": 0,
      "scale": 1
    },

    {
      "src": "/limbus-storylogs/Limbusart/Prologue/S0_1_4.png",
      "opacity": 0.45,
      "fit": "cover",
      "x": 0,
      "y": 0,
      "scale": 1
    }
  ],
      "type": "dialogue"
    },
    {
      "speaker": "Panther",
      "text": "…!",
      "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
  "backgroundLayers": [
    {
      "src": "/limbus-storylogs/Limbusart/Prologue/S0_1_1.png",
      "opacity": 0.45,
      "fit": "cover",
      "x": 0,
      "y": 0,
      "scale": 1
    },

    {
      "src": "/limbus-storylogs/Limbusart/Prologue/S0_1_2.png",
      "opacity": 0.45,
      "fit": "cover",
      "x": 0,
      "y": 0,
      "scale": 1
    },

    {
      "src": "/limbus-storylogs/Limbusart/Prologue/S0_1_4.png",
      "opacity": 0.45,
      "fit": "cover",
      "x": 0,
      "y": 0,
      "scale": 1
    }
  ],
      "type": "dialogue"
    },
    {
      "speaker": "Faust",
      "text": "……",
      "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
      "type": "dialogue"
    },
    {
      "speaker": "Faust",
      "text": "If my eyes are still right, then you will reach the harbor of glory.",
      "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
      "center": "/limbus-storylogs/Sprite/Sinners/Faust/Faust.webp",
      "spriteAdjust": {
    "center": {
      "scale": 2,
      "x": 70,
      "y": -200
    }},
      "type": "dialogue"
    },
    
    {
      "type": "dialogue",
      "speaker": "Dante",
      "icon": "/limbus-storylogs/assets/icons/Dante.png",
      "text": "<Who… are you? That nameplate… says… Faust?>",
      "background": "/limbus-storylogs/assets/covers/backgrounds/Dark_Forest.png",
      "left": "/limbus-storylogs/Sprite/Sinners/Dante/Dante.webp",
      "right": "/limbus-storylogs/Sprite/Sinners/Faust/Faust.webp",
      "spriteAdjust": {
    "right": {
      "scale": 2,
      "x": -40,
      "y": -200
    },
  "left": {
      "scale": 2,
      "x": 200,
      "y": -120}}
    },
    {
      "type": "dialogue",
      "speaker": "Faust",
      "icon": "/limbus-storylogs/assets/icons/Faust.png",
      "text": "You’ve lost your way in a dark forest.",
      "background": "/limbus-storylogs/assets/covers/backgrounds/Dark_Forest.png",
      "left": "/limbus-storylogs/Sprite/Sinners/Dante/Dante.webp",
      "right": "/limbus-storylogs/Sprite/Sinners/Faust/Faust.webp",
      "spriteAdjust": {
    "right": {
      "scale": 2,
      "x": -40,
      "y": -200
    },
  "left": {
      "scale": 2,
      "x": 200,
      "y": -120}}
    },
    {
      "type": "dialogue",
      "speaker": "Dante",
      "icon": "/limbus-storylogs/assets/icons/Dante.png",
      "text": "<I’m… sorry, what?>",
      "background": "/limbus-storylogs/assets/covers/backgrounds/Dark_Forest.png",
      "left": "/limbus-storylogs/Sprite/Sinners/Dante/Dante.webp",
      "right": "/limbus-storylogs/Sprite/Sinners/Faust/Faust.webp",
      "spriteAdjust": {
    "right": {
      "scale": 2,
      "x": -40,
      "y": -200
    },
  "left": {
      "scale": 2,
      "x": 200,
      "y": -120}}
    },
    {
      "type": "dialogue",
      "speaker": "Faust",
      "icon": "/limbus-storylogs/assets/icons/Faust.png",
      "text": "Yet you were not overcome with fear. Why was that?",
      "background": "/limbus-storylogs/assets/covers/backgrounds/Dark_Forest.png",
      "left": "/limbus-storylogs/Sprite/Sinners/Dante/Dante.webp",
      "right": "/limbus-storylogs/Sprite/Sinners/Faust/Faust.webp",
      "spriteAdjust": {
    "right": {
      "scale": 2,
      "x": -40,
      "y": -200
    },
  "left": {
      "scale": 2,
      "x": 200,
      "y": -120}}
    },
    {
      "type": "dialogue",
      "speaker": "Dante",
      "icon": "/limbus-storylogs/assets/icons/Dante.png",
      "text": "<That’s…>",
      "background": "/limbus-storylogs/assets/covers/backgrounds/Dark_Forest.png",
      "left": "/limbus-storylogs/Sprite/Sinners/Dante/Dante.webp",
      "right": "/limbus-storylogs/Sprite/Sinners/Faust/Faust.webp",
      "spriteAdjust": {
    "right": {
      "scale": 2,
      "x": -40,
      "y": -200
    },
  "left": {
      "scale": 2,
      "x": 200,
      "y": -120}}
    },
    {
      "type": "dialogue",
      "speaker": "Dante",
      "icon": "/limbus-storylogs/assets/icons/Dante.png",
      "text": "<I could simply… lift my head to find the star.>",
      "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
      "center": "/limbus-storylogs/Sprite/Sinners/Dante/Dante.webp",
            "spriteAdjust": {
    "center": {
      "scale": 2,
      "x": -40,
      "y": -120
    }}
    },
    {
      "type": "dialogue",
      "speaker": "Faust",
      "icon": "/limbus-storylogs/assets/icons/Faust.png",
      "text": "That’s right.",
      "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
      "center": "/limbus-storylogs/Sprite/Sinners/Faust/Faust.webp",
      "spriteAdjust": {
    "center": {
      "scale": 2,
      "x": 70,
      "y": -200
    }}
    },
    {
      "type": "dialogue",
      "speaker": "Faust",
      "icon": "/limbus-storylogs/assets/icons/Faust.png",
      "text": "Now, repeat with the heart what I tell you aloud as you remind yourself of that image.",
      "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
      "center": "/limbus-storylogs/Sprite/Sinners/Faust/Faust.webp",
      "spriteAdjust": {
    "center": {
      "scale": 2,
      "x": 70,
      "y": -200
    }}
    },
    {
      "type": "dialogue",
      "speaker": "Faust",
      "icon": "/limbus-storylogs/assets/icons/Faust.png",
      "text": "Follow your star.",
      "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg"
    },
    {
      "type": "dialogue",
      "speaker": "Dante",
      "icon": "/limbus-storylogs/assets/icons/Dante.png",
      "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
      "text": "<Follow… your star.>"
    },
    {
      "type": "narration",
      "text": "At that moment…",
      "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg"
    },
    {
      "type": "narration",
      "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
      "text": "I felt a sudden thump in my head."
    },
    {
      "type": "narration",
      "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
      "text": "Followed by the sting of several chains penetrating my chest."
    },
    {
      "type": "dialogue",
      "speaker": "Dante",
      "icon": "/limbus-storylogs/assets/icons/Dante.png",
      "background": "/limbus-storylogs/Limbusart/Prologue/S0_5.png",
      "text": "<Hyag… Ah— Aaagh!!!>"
    },
    {
      "type": "dialogue",
      "speaker": "Faust",
      "icon": "/limbus-storylogs/assets/icons/Faust.png",
      "background": "/limbus-storylogs/Limbusart/Prologue/S0_5.png",
      "text": "Relax. Though it may feel otherwise, your heart is still functional."
    },
    {
      "type": "dialogue",
      "speaker": "Faust",
      "icon": "/limbus-storylogs/assets/icons/Faust.png",
      "background": "/limbus-storylogs/Limbusart/Prologue/S0_5.png",
      "text": "With this, the pact has been sealed."
    },
    {
      "type": "dialogue",
      "speaker": "Faust",
      "icon": "/limbus-storylogs/assets/icons/Faust.png",
      "background": "/limbus-storylogs/Limbusart/Prologue/wp3185342-pure-black-background-wallpaper.jpg",
      "text": "Dante, from this day forth, we are bound to your time."
    },
    {
      "type": "dialogue",
      "speaker": "Dante",
      "icon": "/limbus-storylogs/assets/icons/Dante.png",
      "background": "/limbus-storylogs/Limbusart/Prologue/Dark_Forest.png",
      "center": "/limbus-storylogs/Sprite/Sinners/Dante/Dante.webp",
            "spriteAdjust": {
    "center": {
      "scale": 2,
      "x": -40,
      "y": -120
    }},
      "text": "<What do you…?>"
    },
    {
      "type": "dialogue",
      "speaker": "Faust",
      "icon": "/limbus-storylogs/assets/icons/Faust.png",
      "background": "/limbus-storylogs/Limbusart/Prologue/Dark_Forest.png",
      "center": "/limbus-storylogs/Sprite/Sinners/Faust/Faust.webp",
      "spriteAdjust": {
    "center": {
      "scale": 2,
      "x": 70,
      "y": -200
    }},
      "text": "The beating of our hearts now depends on where your hands fall."
    },
    {
      "type": "dialogue",
      "speaker": "Faust",
      "icon": "/limbus-storylogs/assets/icons/Faust.png",
      "background": "/limbus-storylogs/Limbusart/Prologue/Dark_Forest.png",
      "center": "/limbus-storylogs/Sprite/Sinners/Faust/Faust.webp",
      "spriteAdjust": {
    "center": {
      "scale": 2,
      "x": 70,
      "y": -200
    }},
      "text": "I hope you’ll make a fine leader."
    },
    {
      "type": "dialogue",
      "speaker": "Dante",
      "icon": "/limbus-storylogs/assets/icons/Dante.png",
      "background": "/limbus-storylogs/Limbusart/Prologue/Dark_Forest.png",
      "center": "/limbus-storylogs/Sprite/Sinners/Dante/Dante.webp",
            "spriteAdjust": {
    "center": {
      "scale": 2,
      "x": -40,
      "y": -120
    }},
      "text": "<“Our”…?>"
    },
    {
      "type": "dialogue",
      "speaker": "Ishmael",
      "icon": "/limbus-storylogs/assets/icons/Ishmael.png",
      "text": "Is that really everything?"
    },
    {
      "type": "dialogue",
      "speaker": "Yi Sang",
      "icon": "/limbus-storylogs/assets/icons/YiSang.png",
      "text": "A single apple has fallen."
    },
    {
      "type": "dialogue",
      "speaker": "Ishmael",
      "icon": "/limbus-storylogs/assets/icons/Ishmael.png",
      "text": "…This guy’s still not making any sense."
    },
    {
      "type": "dialogue",
      "speaker": "Rodion",
      "icon": "/limbus-storylogs/assets/icons/Rodion.png",
      "text": "Geeeez~ The wait was killing me! Finally some action now?"
    },
    {
      "type": "dialogue",
      "speaker": "Gregor",
      "icon": "/limbus-storylogs/assets/icons/Gregor.png",
      "text": "Well, I guess we could use a little warm-up."
    },
    {
      "type": "dialogue",
      "speaker": "Outis",
      "icon": "/limbus-storylogs/assets/icons/Outis.png",
      "text": "What is that wretch miserably writhing on the ground? Are they to be the newest addition to the team?"
    },
    {
      "type": "dialogue",
      "speaker": "Gregor",
      "icon": "/limbus-storylogs/assets/icons/Gregor.png",
      "text": "Uh… You might wanna watch your words… I heard that’s our soon-to-be boss…"
    },
    {
      "type": "dialogue",
      "speaker": "Faust",
      "icon": "/limbus-storylogs/assets/icons/Faust.png",
      "text": "The attack must’ve happened in an instant—I’m impressed you managed to hide your head."
    },
    {
      "type": "dialogue",
      "speaker": "Dante",
      "icon": "/limbus-storylogs/assets/icons/Dante.png",
      "text": "<Who are you people? And what’s up with this bus?>"
    },
    {
      "type": "dialogue",
      "speaker": "Faust",
      "icon": "/limbus-storylogs/assets/icons/Faust.png",
      "text": "We are bearers of justice who have come to aid you, and this is the magical bus that takes us wherever we wish to go."
    },
    {
      "type": "dialogue",
      "speaker": "Dante",
      "icon": "/limbus-storylogs/assets/icons/Dante.png",
      "text": "<Justice? Bus? I don’t…>"
    },
    {
      "type": "dialogue",
      "speaker": "Faust",
      "icon": "/limbus-storylogs/assets/icons/Faust.png",
      "text": "Wasn’t that what you expected to hear? Either way, you’re better off believing us to be your saviors."
    },
    {
      "type": "dialogue",
      "speaker": "Faust",
      "icon": "/limbus-storylogs/assets/icons/Faust.png",
      "text": "We’re racing against time and the situation isn’t in our favor, so let me explain this once."
    },
    {
      "type": "narration",
      "text": "After some time passed…"
    },
    {
      "type": "dialogue",
      "speaker": "Dante",
      "icon": "/limbus-storylogs/assets/icons/Dante.png",
      "text": "<So… If I’m not mistaken here and I do as you’ve said, those total strangers will fight for me?>"
    },
    {
      "type": "dialogue",
      "speaker": "Faust",
      "icon": "/limbus-storylogs/assets/icons/Faust.png",
      "text": "Correct. So long as you give them the right orders."
    },
    {
      "type": "dialogue",
      "speaker": "Dante",
      "icon": "/limbus-storylogs/assets/icons/Dante.png",
      "text": "<Alright, so we’ll kill these arrogant vandals dead…>"
    },
    {
      "type": "dialogue",
      "speaker": "Dante",
      "icon": "/limbus-storylogs/assets/icons/Dante.png",
      "text": "<Then I’ll go back to where I was…>"
    },
    {
      "type": "dialogue",
      "speaker": "Dante",
      "icon": "/limbus-storylogs/assets/icons/Dante.png",
      "text": "<Where I was, and…>"
    },
    {
      "type": "dialogue",
      "speaker": "Dante",
      "icon": "/limbus-storylogs/assets/icons/Dante.png",
      "text": "<……>"
    },
    {
      "type": "dialogue",
      "speaker": "Dante",
      "icon": "/limbus-storylogs/assets/icons/Dante.png",
      "text": "<What was I doing? Where was I when I did that?>"
    },
    {
      "type": "dialogue",
      "speaker": "Dante",
      "icon": "/limbus-storylogs/assets/icons/Dante.png",
      "text": "<Something extremely important was upon me. Something I shouldn’t forget…>"
    },
    {
      "type": "dialogue",
      "speaker": "Faust",
      "icon": "/limbus-storylogs/assets/icons/Faust.png",
      "text": "Calm down. It’s only natural to happen with your current head."
    },
    {
      "type": "dialogue",
      "speaker": "Faust",
      "icon": "/limbus-storylogs/assets/icons/Faust.png",
      "text": "You should focus on the struggle at hand, Dante."
    },
    {
      "type": "dialogue",
      "speaker": "Outis",
      "icon": "/limbus-storylogs/assets/icons/Outis.png",
      "text": "Clo… Pardon, I’m not sure how I should address you."
    },
    {
      "type": "dialogue",
      "speaker": "Outis",
      "icon": "/limbus-storylogs/assets/icons/Outis.png",
      "text": "Would Commander Clock suffice…? In any case, we await your orders!"
    },
    {
      "type": "dialogue",
      "speaker": "Gregor",
      "icon": "/limbus-storylogs/assets/icons/Gregor.png",
      "text": "Eh, do we really need orders? Seems like going one-on-one is the only way."
    }
  ]
}
